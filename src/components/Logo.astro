---
// Shared "Radial Six" logo mark (a symmetric hub with 6 outer nodes
// radiating from a white center point) + "SemanticKC" wordmark — used in
// Header and Footer so the two never drift out of sync.
interface Props {
  size?: number;
  class?: string;
}
const { size = 30, class: className = "" } = Astro.props;
---

<span class={`inline-flex items-center gap-2.5 ${className}`}>
  <svg width={size} height={size} viewBox="0 0 30 30" fill="none" aria-hidden="true">
    <line x1="15" y1="15" x2="15" y2="4.5" stroke="#8b5cf6" stroke-width="1.1"></line>
    <line x1="15" y1="15" x2="24.1" y2="9.8" stroke="#8b5cf6" stroke-width="1.1"></line>
    <line x1="15" y1="15" x2="24.1" y2="20.3" stroke="#8b5cf6" stroke-width="1.1"></line>
    <line x1="15" y1="15" x2="15" y2="25.5" stroke="#8b5cf6" stroke-width="1.1"></line>
    <line x1="15" y1="15" x2="5.9" y2="20.3" stroke="#8b5cf6" stroke-width="1.1"></line>
    <line x1="15" y1="15" x2="5.9" y2="9.8" stroke="#8b5cf6" stroke-width="1.1"></line>
    <circle cx="15" cy="4.5" r="2.1" fill="#a78bfa"></circle>
    <circle cx="24.1" cy="9.8" r="2.1" fill="#a78bfa"></circle>
    <circle cx="24.1" cy="20.3" r="2.1" fill="#a78bfa"></circle>
    <circle cx="15" cy="25.5" r="2.1" fill="#a78bfa"></circle>
    <circle cx="5.9" cy="20.3" r="2.1" fill="#a78bfa"></circle>
    <circle cx="5.9" cy="9.8" r="2.1" fill="#a78bfa"></circle>
    <circle cx="15" cy="15" r="3" fill="#fff"></circle>
  </svg>
  <span class="font-display font-bold text-white whitespace-nowrap">
    Semantic<span class="text-accent-300">KC</span>
  </span>
</span>
