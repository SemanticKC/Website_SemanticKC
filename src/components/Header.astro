---
import Logo from "./Logo.astro";

const nav = [
  { href: "/", label: "Home" },
  { href: "/services", label: "Services" },
  { href: "/process", label: "How We Work" },
  { href: "/work", label: "Case Study" },
  { href: "/contact", label: "Contact" },
];
const currentPath = Astro.url.pathname;
---

<header class="sticky top-0 z-50 pt-4 pb-2 bg-gradient-to-b from-brand-950/95 to-brand-950/70 backdrop-blur">
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <div class="flex min-w-0 items-center justify-between gap-3 rounded-full border border-line bg-card px-3 py-2 sm:px-4 sm:pl-6">
      <a href="/" class="min-w-0 shrink-0">
        <Logo size={28} />
      </a>

      <nav class="hidden lg:flex min-w-0 items-center gap-7 xl:gap-8">
        {nav.map((item) => (
          <a
            href={item.href}
            class={`whitespace-nowrap text-sm font-medium transition-colors ${
              currentPath === item.href ? "text-accent-300" : "text-white/70 hover:text-white"
            }`}
          >
            {item.label}
          </a>
        ))}
      </nav>

      <div class="hidden lg:flex shrink-0 items-center gap-4">
        <a
          href="/contact"
          class="whitespace-nowrap rounded-full bg-accent-500 px-5 py-2.5 text-sm font-bold text-white transition-colors hover:bg-accent-600"
        >
          Start a Project
        </a>
      </div>

      <button
        id="menu-toggle"
        type="button"
        class="lg:hidden inline-flex shrink-0 items-center justify-center rounded-full p-2 text-white hover:bg-white/10"
        aria-label="Toggle menu"
        aria-expanded="false"
      >
        <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
        <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" class="hidden h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
        </svg>
      </button>
    </div>

    <div id="mobile-menu" class="hidden lg:hidden">
      <nav class="mt-2 flex flex-col gap-1 rounded-3xl border border-line bg-card p-3">
        {nav.map((item) => (
          <a
            href={item.href}
            class={`min-w-0 rounded-2xl px-4 py-2.5 text-base font-medium ${
              currentPath === item.href ? "text-accent-300 bg-white/5" : "text-white/75 hover:bg-white/5 hover:text-white"
            }`}
          >
            {item.label}
          </a>
        ))}
        <a
          href="/contact"
          class="mt-2 rounded-full bg-accent-500 px-4 py-2.5 text-center text-base font-bold text-white"
        >
          Start a Project
        </a>
      </nav>
    </div>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const iconOpen = document.getElementById("icon-open");
  const iconClose = document.getElementById("icon-close");

  toggle?.addEventListener("click", () => {
    const isHidden = menu?.classList.contains("hidden");
    menu?.classList.toggle("hidden");
    iconOpen?.classList.toggle("hidden");
    iconClose?.classList.toggle("hidden");
    toggle.setAttribute("aria-expanded", String(!!isHidden));
  });
</script>
