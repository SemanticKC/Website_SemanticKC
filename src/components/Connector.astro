---
// Thin line-and-dots "connector" used between stacked sections, echoing the
// node-graph motif without a full background graphic.
---

<div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8" aria-hidden="true">
  <svg class="h-10 w-full" viewBox="0 0 1132 40" preserveAspectRatio="none">
    <line x1="140" y1="20" x2="990" y2="20" stroke="var(--color-line)" stroke-width="1"></line>
    <circle cx="140" cy="20" r="3" fill="#8b5cf6"></circle>
    <circle cx="400" cy="20" r="3" fill="#8b5cf6"></circle>
    <circle cx="660" cy="20" r="3" fill="#8b5cf6"></circle>
    <circle cx="990" cy="20" r="3" fill="#8b5cf6"></circle>
  </svg>
</div>
