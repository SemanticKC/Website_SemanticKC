---
interface Props {
  heading?: string;
  subheading?: string;
}
const {
  heading = "Have a project in mind?",
  subheading = "Tell me a bit about your business and what you need — I'll follow up with next steps.",
} = Astro.props;
---

<section class="px-4 py-20 sm:px-6 sm:py-24 lg:px-8">
  <div class="mx-auto max-w-5xl rounded-3xl border border-line bg-card px-6 py-14 text-center sm:px-14 sm:py-16">
    <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">{heading}</h2>
    <p class="mx-auto mt-4 max-w-2xl text-lg text-white/65">{subheading}</p>
    <div class="mt-8 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href="/contact"
        class="w-full rounded-full bg-accent-500 px-8 py-3.5 text-base font-bold text-white transition-colors hover:bg-accent-600 sm:w-auto"
      >
        Get in Touch
      </a>
      <a
        href="/work"
        class="w-full rounded-full border border-line px-8 py-3.5 text-base font-bold text-white transition-colors hover:bg-white/5 sm:w-auto"
      >
        See Our Work
      </a>
    </div>
  </div>
</section>
