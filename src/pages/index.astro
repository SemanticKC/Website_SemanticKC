---
import Layout from "../layouts/Layout.astro";
import CtaBanner from "../components/CtaBanner.astro";
import NodeGraph from "../components/NodeGraph.astro";
import Connector from "../components/Connector.astro";

const trust = [
  { label: "Built by Developers", sub: "Not a drag-and-drop template mill" },
  { label: "Fast by Default", sub: "Pages load quickly, right from the first click" },
  { label: "No Surprise Monthly Fees", sub: "We skip pointless recurring software costs where a simpler setup works just as well" },
  { label: "Kansas City Based", sub: "Local service businesses, first-hand" },
];

const services = [
  {
    n: "01",
    name: "Custom Site Builds",
    summary: "A site designed and coded around your business, not stretched from a generic template.",
    href: "/services#builds",
  },
  {
    n: "02",
    name: "Content You Can Manage",
    summary: "Content you can update yourself where that's useful, or content we keep maintained for you where that's simpler — your call.",
    href: "/services#self-editable",
  },
  {
    n: "03",
    name: "Lean, Low-Overhead Hosting",
    summary: "No unnecessary monthly software fees when a simpler setup does the job just as well.",
    href: "/services#hosting",
  },
];
---

<Layout title="Custom Websites for Local Service Businesses">
  <!-- Hero -->
  <section class="relative overflow-hidden px-4 pb-16 pt-16 text-center sm:px-6 sm:pb-20 sm:pt-20 lg:px-8">
    <NodeGraph />
    <div class="relative mx-auto max-w-3xl">
      <span class="mb-7 inline-flex items-center gap-2 rounded-full border border-line bg-accent-500/10 px-4 py-1.5 text-sm font-semibold text-accent-300">
        <span aria-hidden="true">&#9679;</span> Web Development &middot; Kansas City
      </span>
      <h1 class="text-4xl font-bold leading-[1.12] tracking-tight text-white sm:text-5xl lg:text-6xl">
        Custom Websites for <span class="text-accent-300">Local Service Businesses</span>
      </h1>
      <p class="mx-auto mt-6 max-w-2xl text-lg text-white/65 sm:text-xl">
        SemanticKC builds fast, low-maintenance websites for contractors, integrators, clinics, and
        shops — sites that load quickly, look professional, and don't saddle you with fees you don't need.
      </p>
      <div class="mt-10 flex flex-col justify-center gap-4 sm:flex-row">
        <a
          href="/contact"
          class="rounded-full bg-accent-500 px-8 py-3.5 text-center text-base font-bold text-white transition-colors hover:bg-accent-600"
        >
          Start a Project
        </a>
        <a
          href="/work"
          class="rounded-full border border-line px-8 py-3.5 text-center text-base font-bold text-white transition-colors hover:bg-white/5"
        >
          See a Real Example
        </a>
      </div>
    </div>
  </section>

  <Connector />

  <!-- Trust bar -->
  <section class="px-4 pb-16 pt-6 sm:px-6 sm:pb-20 lg:px-8">
    <div class="mx-auto grid max-w-7xl grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-4">
      {trust.map((t) => (
        <div class="min-w-0 rounded-2xl border border-line bg-card p-6">
          <span class="mb-4 inline-block h-2.5 w-2.5 rounded-full bg-accent-500 shadow-[0_0_0_4px_rgba(139,92,246,0.15)]"></span>
          <p class="text-base font-bold text-white">{t.label}</p>
          <p class="mt-1.5 text-sm leading-relaxed text-white/55">{t.sub}</p>
        </div>
      ))}
    </div>
  </section>

  <!-- Who it's for -->
  <section class="px-4 pb-16 sm:px-6 sm:pb-20 lg:px-8">
    <div class="mx-auto max-w-3xl rounded-3xl border border-line bg-card px-6 py-12 text-center sm:px-14 sm:py-14">
      <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">Who This Is For</h2>
      <p class="mt-6 text-lg leading-relaxed text-white/65">
        If you run a local service business — contracting, integration, a clinic, a shop — and you want
        a site that actually represents the quality of your work instead of a generic template everyone else
        is using, that's who this is for. You don't need online sales, you don't need a dozen staff
        logins, and you probably don't need to pay some software company every month just to change
        a phone number. You need a site that's fast, looks credible, and is easy to keep up to date.
      </p>
    </div>
  </section>

  <!-- Services -->
  <section id="services" class="px-4 pb-16 sm:px-6 sm:pb-20 lg:px-8">
    <div class="mx-auto max-w-7xl">
      <div class="mx-auto mb-12 max-w-2xl text-center">
        <h2 class="text-3xl font-bold tracking-tight text-white sm:text-4xl">What We Do</h2>
        <p class="mt-4 text-lg text-white/55">
          The same process that built Elite Midwest Integrators' site, applied to your business.
        </p>
      </div>
      <div class="grid grid-cols-1 gap-5 sm:grid-cols-3">
        {services.map((s) => (
          <a
            href={s.href}
            class="group block rounded-2xl border border-line bg-card p-7 transition-all hover:-translate-y-1 hover:border-accent-500"
          >
            <span class="font-display mb-5 flex h-11 w-11 items-center justify-center rounded-full border border-line bg-accent-500/15 font-bold text-accent-300">
              {s.n}
            </span>
            <h3 class="text-lg font-bold text-white">{s.name}</h3>
            <p class="mt-2.5 text-sm leading-relaxed text-white/60">{s.summary}</p>
            <span class="mt-4 inline-flex items-center text-sm font-bold text-accent-300 group-hover:text-accent-500">
              Learn more &rarr;
            </span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured case study teaser -->
  <section class="px-4 pb-16 sm:px-6 sm:pb-20 lg:px-8">
    <div class="mx-auto max-w-5xl rounded-3xl border border-line bg-gradient-to-br from-card to-brand-900 px-6 py-12 text-center sm:px-14 sm:py-14">
      <p class="font-display mb-4 text-sm font-bold uppercase tracking-widest text-accent-300">Case Study</p>
      <h2 class="text-2xl font-bold tracking-tight text-white sm:text-3xl">Elite Midwest Integrators</h2>
      <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-white/60">
        Our first build, and still the clearest example of how we approach every engagement: a Kansas
        City-area low voltage systems integrator, delivered as a fast marketing site the owner can
        update himself — adding a new photo or testimonial takes a couple of clicks, not a call to
        a developer. See it live at <a href="https://emi-kc.com" class="text-accent-300 hover:text-accent-500 underline underline-offset-2" target="_blank" rel="noopener noreferrer">emi-kc.com</a>.
      </p>
      <a href="/work" class="mt-6 inline-flex items-center text-sm font-bold text-accent-300 hover:text-accent-500">
        See how we work &rarr;
      </a>
    </div>
  </section>

  <CtaBanner />
</Layout>
